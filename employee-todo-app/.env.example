# LINE LIFF（寫入／讀取 project-console todo_* 必填，除非開 dev bypass）
# 正式 build 見 `.env.production`（與 shared/js/config.js PROJECT_CONSOLE_LIFF_ID 同步）
# VITE_LIFF_ID=

# project-console Web App URL（預設同 CODING shared/js/config.js GAS_WEB_APP_URL）
# VITE_PROJECT_CONSOLE_URL=

# 本機預覽：對齊 project-console dev_bypass（正式站勿開）
# VITE_TODO_DEV_BYPASS=true
# VITE_TODO_DEV_USER_ID=
